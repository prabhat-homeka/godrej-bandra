# --- Leads → Google Sheet (current destination for this project) ---
# Apps Script web app URL for the leads sheet (see scripts/leads-sheet.gs)
LEADS_SHEET_WEBHOOK_URL=
# Must match SECRET in scripts/leads-sheet.gs
LEADS_SHEET_SECRET=

# --- Homeka CRM lead push (see src/app/api/enquiry/route.ts) ---
# Off for now. Set to "true" to also push leads to the CRM.
PUSH_TO_CRM=false
CRM_API_URL=https://crm.homeka.in
# UUIDs from the CRM's Godrej Bandra West project/subproject.
CRM_PROJECT_ID=
CRM_SUBPROJECT_ID=

# --- Google Ads conversion tracking (optional) ---
# e.g. AW-123456789 — loads the Google tag on every page when set
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label from Google Ads; fires on /thank-you after a real submission
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
